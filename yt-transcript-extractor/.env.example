# YT Transcript Extractor Configuration
# Copy this file to .env and fill in your values

# Base URL for Longcut API (default: https://www.longcut.ai)
BASE_URL=https://www.longcut.ai

# Your Longcut guest token or auth token
TLDW_GUEST_TOKEN=your_token_here

# YouTube video URL to process
TARGET_URL=https://www.youtube.com/watch?v=VIDEO_ID

# Output directory for results (default: ./output)
OUTPUT_DIR=./output

# Output format: json, md, or both (default: md)
OUTPUT_FORMAT=md
