# Credential Switch Script - Environment Configuration
# Copy this file to .env and customize for your setup

# ============================================================================
# SOURCE CONFIGURATION
# ============================================================================

# Path to the source credentials JSON file
# This file contains your client credential definitions (inline or external)
SOURCE_FILE=example/credentials.json

# Client ID to use from the source file
# Must match a key in the source credentials JSON
CLIENT_ID=clientA

# ============================================================================
# DESTINATION CONFIGURATION
# ============================================================================

# Directory containing destination JSON files to update
DEST_DIR=example/

# Comma-separated list of destination files to update
# Example: config.json,app-config.json,settings.json
DEST_FILES=simple-config.json

# Optional: Nested path in destination files where credentials should be updated
# Use dot notation for nested objects (e.g., auth, settings.auth)
# Leave empty to update at root level
DEST_PATH=

# ============================================================================
# EXAMPLES
# ============================================================================

# Example 1: Update nested auth object in multiple files
# SOURCE_FILE=credentials.json
# CLIENT_ID=clientB
# DEST_DIR=./config/
# DEST_FILES=app.json,service.json
# DEST_PATH=auth

# Example 2: Update root level in single file (external credentials)
# SOURCE_FILE=./creds/main.json
# CLIENT_ID=clientA
# DEST_DIR=./
# DEST_FILES=config.json
# DEST_PATH=

# Example 3: Multiple destination files, root level
# SOURCE_FILE=credentials.json
# CLIENT_ID=production
# DEST_DIR=./configs/
# DEST_FILES=api-config.json,worker-config.json,scheduler-config.json
# DEST_PATH=

# ============================================================================
# USAGE NOTES
# ============================================================================

# CLI arguments override .env values:
#   node switch-credentials.js <sourceFile> <clientId> <destDir> <destFile1> [destFile2...] [--destPath=path]

# Run with .env only (no CLI args):
#   node switch-credentials.js

# Credential Types:
# - inline: Credentials stored directly in source file
# - external: Credentials referenced from external file with selective field extraction

# See README.md for detailed documentation
