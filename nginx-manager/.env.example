# Nginx Manager Configuration
# Copy this file to .env and adjust as needed

# Directory where app route configs are stored
NGINX_APPS_DIR=/etc/nginx/apps.d

# Prefix for generated config filenames (e.g. "rnd" → rnd-myapp.conf)
NGINX_PREFIX=rnd

# Domain used in config headers for documentation
NGINX_DOMAIN=example.com

# Directory containing nginx snippet files
NGINX_SNIPPETS=/etc/nginx/snippets
